{
  "include": ["~/.config/waybar/common.jsonc"],
  "name": "topbar-detailed",
  "position": "top",
  "width": "auto",
  "margin": "0 10 0 10",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "group/hardware",
    "group/comms",
    "tray",
    "custom/notification",
    "custom/power"
  ],

  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {used:0.1f}G" },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀 ON",
    "format-disconnected": "󰤭 OFF",
    "format-disabled": "󰖪 OFF"
  },
  "clock": { "format": " {:%A, %b %d  %H:%M}" },
  "custom/peripheral": {
    "exec": "$HOME/.config/waybar/scripts/peripheral-monitor.sh --horizontal"
  }
}
