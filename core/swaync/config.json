{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 460,
  "control-center-height": -1,
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-left": 10,
  "control-center-margin-right": 10,
  "notification-window-width": 420,
  "notification-grouping": true,
  "fit-to-screen": false,
  "layer": "overlay",
  "control-center-layer": "overlay",
  "cssPriority": "user",
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 5,
  "timeout-low": 2,
  "timeout-critical": 0,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "backlight",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "PILOT HUD",
      "clear-all-button": true,
      "button-text": "PURGE"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/pilot-control.sh wifi",
          "update-command": "~/.config/swaync/scripts/pilot-control.sh wifi-status"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/pilot-control.sh bluetooth",
          "update-command": "~/.config/swaync/scripts/pilot-control.sh bt-status"
        },
        {
          "label": "󱛄",
          "command": "wihotspot-gui"
        },
        {
          "label": "󰊖",
          "command": "~/.config/swaync/scripts/pilot-control.sh gamemode"
        },
        {
          "label": "󰕾",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/volume.sh toggle",
          "update-command": "~/.config/swaync/scripts/volume.sh status"
        },
        {
          "label": "󰄄",
          "command": "~/.config/hypr/scripts/screenshot-swappy.sh"
        },
        {
          "label": "󰍺",
          "command": "~/.config/hypr/scripts/mirror-hotplug.sh"
        },
        {
          "label": "󰉋",
          "command": "thunar"
        },
        {
          "label": "󰅇",
          "command": "~/.config/hypr/scripts/cliphist-rofi.sh"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "expand-button-label": "󰅀",
      "collapse-button-label": "󰅃",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true
    },
    "backlight": {
      "label": "󰃠",
      "device": ""
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "notifications": {
      "vexpand": false
    }
  }
}
