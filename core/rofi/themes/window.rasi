/**
 * Titanfall Active Window Switcher Theme
 * Minimalist, high-readability layout for cross-workspace window navigation.
 **/

@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    font: "Orbitron 10";
    background-color: transparent;
    text-color: @foreground;

    bg-base:     rgba(10, 15, 20, 0.92);
    bg-selected: @selected-normal-background;
    bg-alt:      rgba(255, 255, 255, 0.05);
    accent-color: @selected-active-background;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 880px;
    border-radius: 15px;
    border: 2px;
    border-color: @accent-color;
    background-color: @bg-base;
    padding: 20px;
}

mainbox {
    spacing: 15px;
    children: [ "inputbar", "listview", "message" ];
}

inputbar {
    orientation: horizontal;
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent-color;
}

entry {
    placeholder: "Search active windows across workspaces...";
    placeholder-color: @foreground;
    text-color: #ffffff;
    expand: true;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
    fixed-height: false;
}

element {
    orientation: horizontal;
    spacing: 14px;
    padding: 10px 14px;
    border-radius: 10px;
    background-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1px;
    border-color: @accent-color;
}

element-icon {
    size: 32px;
    cursor: inherit;
    background-color: transparent;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
    font: "Orbitron 10";
    expand: true;
}

/* Keybind hints footer */
message {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 8px 14px;
}

textbox {
    text-color: @foreground;
    font: "Orbitron 8";
    horizontal-align: 0.5;
}
