/**
 * JaKooLit Inspired Application Launcher
 * Features: Grid layout, mode switcher, modern aesthetics.
 **/

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}";
    terminal: "kitty";
    run-shell-command: "{terminal} -e {cmd}";
}

@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    font: "Orbitron 10";
    background-color: transparent;
    text-color: @foreground;
    
    bg-base: var(bg-base, rgba(10, 15, 20, 0.85));
    bg-selected: var(bg-selected, @selected-normal-background);
    bg-alt: var(bg-alt, rgba(255, 255, 255, 0.05));
    
    border-color: var(border-accent, @selected-active-background);
    accent-color: var(accent-color, @selected-active-background);
    
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 950px;
    border-radius: 15px;
    border: 2px;
    border-color: var(border-accent, @accent-color);
    background-color: @bg-base;
    padding: 20px;
}

mainbox {
    spacing: 20px;
    children: [ "inputbar", "listview" ];
}

/* SEARCH BAR */
inputbar {
    orientation: horizontal;
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent-color;
}

entry {
    placeholder: "Search apps, math, web (? / !w / !yt), or > command...";
    placeholder-color: var(accent-alt, @foreground);
    text-color: @foreground;
    expand: true;
}

/* APP GRID */
listview {
    columns: 5;
    lines: 4;
    spacing: 15px;
    fixed-height: false;
    fixed-columns: true;
    flow: horizontal;
    scrollbar: false;
}

element {
    orientation: vertical;
    spacing: 10px;
    padding: 15px 10px;
    border-radius: 12px;
    background-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1px;
    border-color: @accent-color;
}

element-icon {
    size: 48px;
    cursor: inherit;
    horizontal-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    text-color: inherit;
    cursor: inherit;
    font: "Orbitron 9";
}
