{
  "include": ["~/.config/waybar/common.jsonc"],
  "name": "sidebar-minimal",
  "position": "left",
  "height": 40,
  "margin": "10 5 10 10",
  "width": "auto",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "hyprland/language",
    "custom/notification",
    "custom/peripheral",
    "custom/power"
  ],

  "clock": { "format": "\n{:%H\n%M}" },
  "custom/peripheral": {
    "exec": "$HOME/.config/waybar/scripts/peripheral-monitor.sh"
  }
}
