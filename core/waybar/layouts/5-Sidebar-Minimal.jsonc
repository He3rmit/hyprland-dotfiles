{
  "include": ["~/.config/waybar/common.jsonc"],
  "name": "sidebar-minimal",
  "position": "left",
  "width": "auto",
  "height": 45,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["tray", "clock", "hyprland/language", "custom/notification", "custom/peripheral", "custom/power"],

  "hyprland/language": {
      "format": "󰌌\n{}",
      "format-en": "US",
      "format-us": "US",
      "format-de": "DE",
      "format-fr": "FR",
      "format-es": "ES",
      "format-ru": "RU",
      "format-ja": "JP",
      "format-jp": "JP"
  },
  "hyprland/workspaces": { "format": "{icon}" },
  "clock": { "format": "\n{:%H\n%M}" },
  "custom/peripheral": {
      "exec": "$HOME/.config/waybar/scripts/peripheral-monitor.sh"
  }
}
