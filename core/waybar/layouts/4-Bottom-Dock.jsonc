{
  "include": ["~/.config/waybar/common.jsonc"],
  "name": "bottom-dock",
  "position": "bottom",
  "width": "auto",
  "height": 45,
  "margin": "0 20 10 20",
  "modules-left": ["group/hardware", "hyprland/window"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "tray",
    "clock",
    "hyprland/language",
    "custom/peripheral",
    "custom/notification",
    "custom/power"
  ],

  "hyprland/language": { "format": "󰌌 {short}" },
  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {used:0.1f}G" },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀 ON",
    "format-disconnected": "󰤭 OFF"
  },
  "clock": { "format": " {:%H:%M}" },
  "custom/peripheral": {
    "exec": "$HOME/.config/waybar/scripts/peripheral-monitor.sh --horizontal"
  }
}
