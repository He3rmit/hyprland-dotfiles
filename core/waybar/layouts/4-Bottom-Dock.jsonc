{
  "include": ["~/.config/waybar/common.jsonc"],
  "name": "bottom-dock",
  "position": "bottom",
  "width": "auto",
  "height": 45,
  "margin": "0 20 10 20",
  "modules-left": ["cpu", "memory", "network"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["tray", "clock", "hyprland/language", "custom/peripheral", "custom/notification", "custom/power"],

  "hyprland/language": {
      "format": "󰌌 {}",
      "format-en": "󰌌 US",
      "format-us": "󰌌 US",
      "format-de": "󰌌 DE",
      "format-fr": "󰌌 FR",
      "format-es": "󰌌 ES",
      "format-ru": "󰌌 RU",
      "format-ja": "󰌌 JP",
      "format-jp": "󰌌 JP"
  },
  "hyprland/workspaces": { "format": "{icon}" },
  "cpu": { "format": "  {usage}%" },
  "memory": { "format": "  {used:0.1f}G" },
  "network": { "format-wifi": "  {signalStrength}%", "format-ethernet": "󰈀", "format-disconnected": "⚠" },
  "custom/peripheral": {
      "exec": "$HOME/.config/waybar/scripts/peripheral-monitor.sh --horizontal"
  }
}
