{
  "include": ["~/.config/waybar/common.jsonc"],
  "name": "topbar-detailed",
  "position": "top",
  "height": 42,
  "margin": "0 10 0 10",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "group/hardware",
    "group/comms",
    "tray",
    "hyprland/language",
    "custom/notification",
    "custom/power"
  ],

  "hyprland/language": { "format": "󰌌  {short}" },
  "cpu": { "format": "  {usage}%" },
  "memory": { "format": "  {used:0.1f}G" },
  "network": {
    "format-wifi": "󰤨  {signalStrength}%",
    "format-ethernet": "󰈀  ON",
    "format-disconnected": "󰤭  OFF",
    "format-disabled": "󰖪  OFF"
  },
  "clock": { "format": "  {:%A, %b %d  %H:%M}" },
  "custom/peripheral": {
    "exec": "$HOME/.config/waybar/scripts/peripheral-monitor.sh --horizontal"
  }
}
